{
  "name": "tangent-reader",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p worker && vite build",
    "typecheck": "tsc && tsc -p worker && tsc -p evals",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "e2e": "playwright test",
    "eval": "vitest run --config vitest.eval.config.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "dexie": "4.4.6",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
