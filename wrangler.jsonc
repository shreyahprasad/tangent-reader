// Hosting on Cloudflare (docs/design.md, Architecture): one Worker serving the built page as static
// assets, and the URL fetch (worker/index.ts) on the same origin, so the page needs no CORS.
// Deploy from a fresh build: `pnpm build`, then `pnpm dlx wrangler@4.149.0 deploy`.
{
  "name": "tangent-reader",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    // Every address is a hash (#/...), so anything else is the page itself.
    "not_found_handling": "single-page-application",
    // The Worker runs only for /fetch; every other request is a file.
    "run_worker_first": ["/fetch"]
  },
  // Per caller, 20 links a minute. Cloudflare counts it per data center, loosely by design: it
  // slows a misuse, it does not stop one (docs/design.md, Import).
  "ratelimits": [{ "name": "FETCH_LIMIT", "namespace_id": "5001", "simple": { "limit": 20, "period": 60 } }],
  // Nothing is logged (docs/design.md, Architecture), and no version gets a preview address of its own.
  "observability": { "enabled": false },
  "preview_urls": false
}
